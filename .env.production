# ============================================================
# AuthForm — Production Environment Configuration
# ============================================================
# This file is loaded ONLY during `vite build` (production).
# For local development, copy to .env.local and adjust values.
# NEVER commit secrets to version control — add .env* to .gitignore.
# ============================================================

# ── Backend API Base URL ─────────────────────────────────────
# Centralized backend service deployed on Render.
# All Axios requests originate from this base path.
VITE_API_URL=http://localhost:5000/api

# ── Role-Based Redirect Targets ──────────────────────────────
# Admin / CEO / CRM roles are redirected to the management dashboard.
VITE_DASHBOARD_URL=https://frontend-dashboard-one-ashen.vercel.app

# Employee role is redirected to the employee operations dashboard.
VITE_EMPLOYEE_URL=https://employee-dashboard-seven-omega.vercel.app
